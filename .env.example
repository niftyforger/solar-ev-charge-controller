# Copy this file to ".env" (gitignored, never committed) and fill in your
# own values.
#
# Also used to auto-generate include/secrets.h before every build (any pio
# env, any invocation path) - see tools/sync_secrets.py. That's the only
# place OTA_PASSWORD needs to be set now.
OTA_PASSWORD=

# The board's IP or mDNS hostname on your LAN, e.g. solar-ev-charger.local
UPLOAD_PORT=

# For [env:ota]'s OTA upload (espota), these two values above need to reach
# PlatformIO as PLATFORMIO_UPLOAD_PORT/PLATFORMIO_UPLOAD_FLAGS env vars -
# see the [env:ota] comment in platformio.ini for why a gitignored .env file
# can't feed those directly. Two ways to actually apply this file:
#   - `python tools/ota_upload.py` for the CLI (loads .env for that one run)
#   - `python tools/sync_env_vars.py` once, then restart VSCode, for the
#     PlatformIO IDE's "Upload" button to work directly
